{
  "name": "expreso-punata",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "npm run test:unit",
    "lint": "eslint .",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:rules": "firebase emulators:exec --only firestore,auth \"node --test tests/rules/firestoreRules.test.mjs\"",
    "test:functions": "firebase emulators:exec --only firestore,auth,storage \"npm --prefix functions test\"",
    "test:caja-lifecycle": "firebase emulators:exec --only firestore,auth \"node tests/e2e/runCajaLifecycle.mjs\"",
    "test:logistics-lifecycle": "firebase emulators:exec --only firestore,auth \"node tests/e2e/runLogisticsLifecycle.mjs\"",
    "test:delivery-lifecycle": "firebase emulators:exec --only firestore,auth,storage \"node tests/e2e/runDeliveryAndCodLifecycle.mjs\"",
    "test:e2e": "node tests/e2e/runBrowserVerification.mjs",
    "emulators": "firebase emulators:start --only auth,firestore,storage,functions",
    "admin:bootstrap": "node scripts/bootstrapAdmin.mjs",
    "test:journey": "firebase emulators:exec --only firestore,auth,storage \"node tests/e2e/runFullAuthenticatedBusinessJourney.mjs\""
  },
  "dependencies": {
    "firebase": "^12.15.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.21.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^24.12.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.22",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-admin": "^14.5.0",
    "globals": "^17.6.0",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
