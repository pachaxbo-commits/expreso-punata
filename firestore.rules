rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funciones auxiliares de autenticación y autorización
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // El documento en Firestore es la fuente autoritativa de verdad
    function isActive() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        ('isActive' in getUserData()) &&
        getUserData().isActive == true &&
        (!('isActive' in request.auth.token) || request.auth.token.isActive == true);
    }
    
    // Rol autoritativo desde Firestore
    function getUserRole() {
      return ('role' in getUserData()) ? getUserData().role : ('role' in request.auth.token ? request.auth.token.role : null);
    }
    
    function isAdmin() {
      return getUserRole() == 'directiva_admin';
    }

    function isTreasury() {
      return getUserRole() == 'tesoreria' || isAdmin();
    }

    function isAgencyManager() {
      return getUserRole() == 'encargado_agencia' || isAdmin();
    }

    function isCashier() {
      return getUserRole() in ['secretaria', 'encargado_agencia', 'directiva_admin'];
    }

    function isDriver() {
      return getUserRole() == 'conductor';
    }

    function isBranchAllowed(branchId) {
      return ('primaryBranchId' in getUserData() && getUserData().primaryBranchId == branchId) ||
             ('allowedBranchIds' in getUserData() && branchId in getUserData().allowedBranchIds);
    }

    // =========================================================================
    // COLECCIÓN: branches (Sucursales: Punata y Cochabamba)
    // =========================================================================
    match /branches/{branchId} {
      allow read: if isActive();
      allow write: if false; // Solo Admin SDK / Cloud Functions
      
      // Subcolección: shelves y modules (Almacenamiento Físico de Catálogo)
      match /shelves/{shelfId} {
        allow read: if isActive();
        allow write: if false; // Solo Cloud Function manageShelf
        
        match /modules/{moduleId} {
          allow read: if isActive();
          allow write: if false;
        }
      }
    }

    // =========================================================================
    // COLECCIÓN: users (Perfiles, Roles y Sucursales Asignadas)
    // =========================================================================
    match /users/{userId} {
      // Cada usuario puede leer su propio perfil; directiva y encargados activos pueden leer otros
      allow read: if isAuthenticated() && (request.auth.uid == userId || (isActive() && (isAdmin() || isAgencyManager())));
      // Solo Cloud Functions con Admin SDK puede crear o modificar perfiles
      allow write: if false;
    }

    // =========================================================================
    // COLECCIÓN: counters (Generación atómica de números de guía en backend)
    // =========================================================================
    match /counters/{counterId} {
      allow read, write: if false; // Exclusivo de Cloud Functions con Admin SDK
    }

    // =========================================================================
    // COLECCIÓN: idempotency_keys (Control de idempotencia del backend)
    // =========================================================================
    match /idempotency_keys/{keyId} {
      allow read, write: if false; // Exclusivo de Cloud Functions con Admin SDK
    }

    // =========================================================================
    // COLECCIÓN: financial_movements (Movimientos financieros auditables)
    // =========================================================================
    match /financial_movements/{movementId} {
      allow read: if isActive() && (
        isAdmin() ||
        isTreasury() ||
        ((isCashier() || isAgencyManager()) && isBranchAllowed(resource.data.branchId))
      );
      allow write: if false; // Solo backend en transacciones atómicas
    }

    // =========================================================================
    // COLECCIÓN: shipments (Encomiendas - Servidor Autoritativo)
    // =========================================================================
    match /shipments/{shipmentId} {
      // Lectura: secretarias de origen o destino autorizadas, admin, tesorería, o conductor asignado
      allow read: if isActive() && (
        isAdmin() ||
        isTreasury() ||
        ((isCashier() || isAgencyManager()) && (
          isBranchAllowed(resource.data.originBranchId) ||
          isBranchAllowed(resource.data.destinationBranchId)
        )) ||
        (isDriver() && ('assignedVehicle' in resource.data) && resource.data.assignedVehicle.driverUid == request.auth.uid)
      );

      // Creación, actualización y eliminación: TOTALMENTE BLOQUEADAS desde el navegador.
      // Todas las transiciones de estado, custodia, recepción, almacenamiento y entrega
      // deben procesarse exclusivamente a través de Cloud Functions autorizadas.
      allow write: if false;

      // Subcolección: status_logs (Historial auditado independiente)
      match /status_logs/{logId} {
        allow read: if isActive() && (
          isAdmin() ||
          isTreasury() ||
          ((isCashier() || isAgencyManager()) && (
            isBranchAllowed(get(/databases/$(database)/documents/shipments/$(shipmentId)).data.originBranchId) ||
            isBranchAllowed(get(/databases/$(database)/documents/shipments/$(shipmentId)).data.destinationBranchId)
          )) ||
          (isDriver() && ('assignedVehicle' in get(/databases/$(database)/documents/shipments/$(shipmentId)).data) &&
           get(/databases/$(database)/documents/shipments/$(shipmentId)).data.assignedVehicle.driverUid == request.auth.uid)
        );
        allow write: if false; // Solo backend append-only
      }

      // Subcolección: storage_moves (Historial de traslados físicos entre módulos)
      match /storage_moves/{moveId} {
        allow read: if isActive() && (
          isAdmin() ||
          isTreasury() ||
          ((isCashier() || isAgencyManager()) && (
            isBranchAllowed(get(/databases/$(database)/documents/shipments/$(shipmentId)).data.originBranchId) ||
            isBranchAllowed(get(/databases/$(database)/documents/shipments/$(shipmentId)).data.destinationBranchId)
          ))
        );
        allow write: if false; // Solo backend append-only
      }
    }

    // =========================================================================
    // COLECCIÓN: vehicles (Padrón de Móviles y Flota de Expreso Punata)
    // =========================================================================
    match /vehicles/{vehicleId} {
      allow read: if isActive();
      allow write: if false; // Solo Cloud Function manageVehicle con validación de unicidad y concurrencia
    }

    // =========================================================================
    // COLECCIÓN: driver_directory (Directorio operativo público de conductores)
    // =========================================================================
    match /driver_directory/{driverId} {
      allow read: if isActive();
      allow write: if false; // Solo Cloud Function sincronizada
    }

    // =========================================================================
    // COLECCIÓN: driver_custody_accounts (Libro de Saldos de Custodia de Choferes)
    // =========================================================================
    match /driver_custody_accounts/{driverUid} {
      allow read: if isActive() && (
        isAdmin() ||
        isTreasury() ||
        isAgencyManager() ||
        isCashier() ||
        (isDriver() && request.auth.uid == driverUid)
      );
      allow write: if false; // Exclusivo de transacciones backend en Cloud Functions
    }

    // =========================================================================
    // COLECCIÓN: driver_custody_records (Asientos de Cobros en Ruta y Remesas)
    // =========================================================================
    match /driver_custody_records/{recordId} {
      allow read: if isActive() && (
        isAdmin() ||
        isTreasury() ||
        isAgencyManager() ||
        isCashier() ||
        (isDriver() && resource.data.driverUid == request.auth.uid)
      );
      allow write: if false; // Exclusivo de transacciones backend en Cloud Functions
    }

    // =========================================================================
    // COLECCIÓN: driver_settlements (Liquidaciones de fondos en custodia de conductores)
    // =========================================================================
    match /driver_settlements/{settlementId} {
      allow read: if isActive() && (
        isAdmin() ||
        isTreasury() ||
        isAgencyManager() ||
        isCashier() ||
        (isDriver() && resource.data.driverUid == request.auth.uid)
      );
      allow write: if false; // Solo Cloud Function settleDriverCash
    }

    // =========================================================================
    // COLECCIÓN: manifests (Despachos y Manifiestos de Carga - Servidor Autoritativo)
    // =========================================================================
    match /manifests/{manifestId} {
      allow read: if isActive() && (
        isAdmin() ||
        isTreasury() ||
        ((isCashier() || isAgencyManager()) && (
          isBranchAllowed(resource.data.originBranchId) ||
          isBranchAllowed(resource.data.destinationBranchId)
        )) ||
        (isDriver() && resource.data.driverUid == request.auth.uid)
      );
      // Creación, actualización y transiciones operativas:
      // Exclusivo de Cloud Functions atómicas (createDispatchManifest, receiveDispatchManifest, driverConfirmCustody)
      allow write: if false;
    }

    // =========================================================================
    // COLECCIÓN: cash_shifts (Turnos de Caja - Autoridad Exclusiva de Backend)
    // =========================================================================
    match /cash_shifts/{shiftId} {
      // Secretaria lee su propio turno; encargados y tesorería ven los de su sucursal o global
      allow read: if isActive() && (
        resource.data.operatorUid == request.auth.uid ||
        (isAgencyManager() && isBranchAllowed(resource.data.branchId)) ||
        isTreasury() ||
        isAdmin()
      );

      // Apertura, cierre y modificaciones: TOTALMENTE PROHIBIDAS desde clientes
      allow write: if false; // Solo Cloud Functions autorizadas en transacciones atómicas
    }

    // =========================================================================
    // COLECCIÓN: cash_shift_active_locks (Candados determinísticos de turno activo)
    // =========================================================================
    match /cash_shift_active_locks/{lockId} {
      allow read: if isActive() && (
        resource.data.operatorUid == request.auth.uid ||
        (isAgencyManager() && isBranchAllowed(resource.data.branchId)) ||
        isTreasury() ||
        isAdmin()
      );
      allow write: if false; // Solo Cloud Functions atómicas
    }

    // =========================================================================
    // COLECCIÓN: system_locks (Candados de sincronización interna del backend)
    // =========================================================================
    match /system_locks/{lockId} {
      allow read, write: if false; // Solo Firebase Admin SDK
    }

    // =========================================================================
    // COLECCIÓN: expense_authorizations (Autorizaciones de egresos extraordinarios)
    // =========================================================================
    match /expense_authorizations/{authId} {
      allow read: if isActive() && (isAdmin() || isAgencyManager() || isCashier());
      allow write: if false; // Solo Cloud Functions autorizadas con Admin SDK
    }

    // =========================================================================
    // COLECCIÓN: branch_consumables (Inventario de insumos y consumibles)
    // =========================================================================
    match /branch_consumables/{consumableId} {
      allow read: if isActive() && (isAdmin() || isAgencyManager() || isTreasury() || isCashier());
      allow write: if false; // Exclusivo de Cloud Functions (manageConsumable)

      match /movements/{movementId} {
        allow read: if isActive() && (isAdmin() || isAgencyManager() || isTreasury() || isCashier());
        allow write: if false;
      }
    }

    // =========================================================================
    // COLECCIÓN: fixed_assets (Inventario / Bienes Fijos de Expreso Punata)
    // =========================================================================
    match /fixed_assets/{assetId} {
      allow read: if isActive() && (isAdmin() || isAgencyManager() || isTreasury() || isCashier());
      allow write: if false; // Exclusivo de Cloud Functions (manageFixedAsset)

      match /audit_logs/{auditId} {
        allow read: if isActive() && (isAdmin() || isAgencyManager() || isTreasury());
        allow write: if false; // Inmutable, solo Cloud Functions
      }
    }

    // =========================================================================
    // COLECCIONES SINDICALES: members, dues, workers, worker_payments, expenses
    // =========================================================================
    match /union_members/{memberId} {
      allow read: if isActive() && (isTreasury() || isAdmin() || isAgencyManager() || isCashier());
      allow write: if false; // Exclusivo de Cloud Functions (manageUnionMember)
    }

    match /union_dues/{dueId} {
      allow read: if isActive() && (isTreasury() || isAdmin() || isAgencyManager() || isCashier());
      allow write: if false; // Exclusivo de Cloud Functions (generateMonthlyDues, collectMemberDue)

      match /payments/{paymentId} {
        allow read: if isActive() && (isTreasury() || isAdmin() || isAgencyManager() || isCashier());
        allow write: if false; // Inmutable, solo Cloud Functions (collectMemberDue)
      }
    }

    match /union_workers/{workerId} {
      allow read: if isActive() && (isTreasury() || isAdmin() || isAgencyManager());
      allow write: if false; // Exclusivo de Cloud Functions (manageWorker)
    }

    match /union_worker_payments/{paymentId} {
      allow read: if isActive() && (isTreasury() || isAdmin() || isAgencyManager());
      allow write: if false; // Inmutable, solo Cloud Functions (registerWorkerPayment)
    }

    match /union_expenses/{expenseId} {
      allow read: if isActive() && (isTreasury() || isAdmin() || isAgencyManager() || isCashier());
      allow write: if false; // Inmutable, solo Cloud Functions (registerGeneralExpense)
    }

    // =========================================================================
    // COLECCIÓN: audit_logs (Logs de auditoría inmutables)
    // =========================================================================
    match /audit_logs/{auditId} {
      allow read: if isActive() && isAdmin();
      allow write: if false; // Exclusivo de Cloud Functions con Admin SDK
    }

    // =========================================================================
    // REGLA POR DEFECTO: DENEGAR TODO ACCESO NO ESPECIFICADO
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
