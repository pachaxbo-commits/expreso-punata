rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funciones auxiliares de autenticación y autorización
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // El documento en Firestore es la fuente autoritativa de verdad
    function isActive() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        ('isActive' in getUserData()) &&
        getUserData().isActive == true &&
        (!('isActive' in request.auth.token) || request.auth.token.isActive == true);
    }
    
    // Rol autoritativo desde Firestore
    function getUserRole() {
      return ('role' in getUserData()) ? getUserData().role : ('role' in request.auth.token ? request.auth.token.role : null);
    }
    
    // Sucursal autoritativa desde Firestore
    function getUserBranch() {
      return ('primaryBranchId' in getUserData()) ? getUserData().primaryBranchId : ('branchId' in request.auth.token ? request.auth.token.branchId : null);
    }

    function isAdmin() {
      return getUserRole() == 'directiva_admin';
    }

    function isTreasury() {
      return getUserRole() == 'tesoreria' || isAdmin();
    }

    function isAgencyManager() {
      return getUserRole() == 'encargado_agencia' || isAdmin();
    }

    function isCashier() {
      return getUserRole() in ['secretaria', 'encargado_agencia', 'directiva_admin'];
    }

    function isDriver() {
      return getUserRole() == 'conductor';
    }

    function isBranchAllowed(branchId) {
      return ('primaryBranchId' in getUserData() && getUserData().primaryBranchId == branchId) ||
             ('allowedBranchIds' in getUserData() && branchId in getUserData().allowedBranchIds);
    }

    function isValidStatusTransition(oldStatus, newStatus) {
      return (oldStatus == newStatus) ||
        (oldStatus == 'received' && newStatus in ['in_warehouse', 'in_transit', 'cancelled']) ||
        (oldStatus == 'in_warehouse' && newStatus in ['in_transit', 'cancelled']) ||
        (oldStatus == 'in_transit' && newStatus in ['arrived_at_destination', 'in_delivery']) ||
        (oldStatus == 'arrived_at_destination' && newStatus in ['in_delivery', 'delivered', 'returned']) ||
        (oldStatus == 'in_delivery' && newStatus in ['delivered', 'arrived_at_destination', 'returned']);
    }

    // =========================================================================
    // COLECCIÓN: branches (Sucursales: Punata y Cochabamba)
    // =========================================================================
    match /branches/{branchId} {
      allow read: if isActive();
      allow write: if isActive() && isAdmin();
      
      // Subcolección: shelves y modules (Almacenamiento Físico)
      match /shelves/{shelfId} {
        allow read: if isActive();
        allow write: if isActive() && isAgencyManager() && isBranchAllowed(branchId);
        
        match /modules/{moduleId} {
          allow read: if isActive();
          allow write: if isActive() && isCashier() && isBranchAllowed(branchId);
        }
      }
    }

    // =========================================================================
    // COLECCIÓN: users (Perfiles, Roles y Sucursales Asignadas)
    // =========================================================================
    match /users/{userId} {
      // Cada usuario puede leer su propio perfil; directiva y encargados activos pueden leer otros
      allow read: if isAuthenticated() && (request.auth.uid == userId || (isActive() && (isAdmin() || isAgencyManager())));
      // Solo Cloud Functions con Admin SDK puede crear o modificar perfiles
      allow write: if false;
    }

    // =========================================================================
    // COLECCIÓN: counters (Generación atómica de números de guía en backend)
    // =========================================================================
    match /counters/{counterId} {
      allow read, write: if false; // Exclusivo de Cloud Functions con Admin SDK
    }

    // =========================================================================
    // COLECCIÓN: idempotency_keys (Control de idempotencia del backend)
    // =========================================================================
    match /idempotency_keys/{keyId} {
      allow read, write: if false; // Exclusivo de Cloud Functions con Admin SDK
    }

    // =========================================================================
    // COLECCIÓN: financial_movements (Movimientos financieros auditables)
    // =========================================================================
    match /financial_movements/{movementId} {
      allow read: if isActive() && (
        isAdmin() ||
        isTreasury() ||
        ((isCashier() || isAgencyManager()) && isBranchAllowed(resource.data.branchId))
      );
      allow write: if false; // Solo backend en transacciones atómicas
    }

    // =========================================================================
    // COLECCIÓN: shipments (Encomiendas)
    // =========================================================================
    match /shipments/{shipmentId} {
      // Lectura: secretarias de origen o destino autorizadas, admin, tesorería, o conductor asignado
      allow read: if isActive() && (
        isAdmin() ||
        isTreasury() ||
        ((isCashier() || isAgencyManager()) && (
          isBranchAllowed(resource.data.originBranchId) ||
          isBranchAllowed(resource.data.destinationBranchId)
        )) ||
        (isDriver() && ('assignedVehicle' in resource.data) && resource.data.assignedVehicle.driverUid == request.auth.uid)
      );

      // Creación: TOTALMENTE PROHIBIDA desde clientes / navegadores directos
      allow create: if false;

      // Actualización autorizada:
      // PROHIBIDO alterar importes, correlativos, IDs o movimientos financieros desde el cliente
      allow update: if isActive() && (
        (isAdmin() && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'finalAmountCents', 'shippingFeeCents', 'weightSurchargeCents', 'homeDeliveryFeeCents',
          'discountCents', 'trackingCode', 'id', 'idempotencyKey', 'registeredByUid', 'financialMovementId', 'createdAt'
        ])) ||
        (isCashier() && (isBranchAllowed(resource.data.originBranchId) || isBranchAllowed(resource.data.destinationBranchId)) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'storageLocation', 'updatedAt', 'deliveryRecord']) &&
         isValidStatusTransition(resource.data.status, request.resource.data.status) &&
         (request.resource.data.status != 'delivered' || (request.resource.data.deliveryRecord != null && request.resource.data.deliveryRecord.receivedByName is string))) ||
        (isDriver() && ('assignedVehicle' in resource.data) && resource.data.assignedVehicle.driverUid == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'deliveryRecord', 'driverCustody', 'updatedAt']) &&
         isValidStatusTransition(resource.data.status, request.resource.data.status) &&
         (request.resource.data.status != 'delivered' || (request.resource.data.deliveryRecord != null && request.resource.data.deliveryRecord.receivedByName is string)))
      );

      // Eliminación prohibida: Las encomiendas son inmutables
      allow delete: if false;

      // Subcolección: status_logs (Historial auditado independiente)
      match /status_logs/{logId} {
        allow read: if isActive() && (
          isAdmin() ||
          isTreasury() ||
          ((isCashier() || isAgencyManager()) && (
            isBranchAllowed(get(/databases/$(database)/documents/shipments/$(shipmentId)).data.originBranchId) ||
            isBranchAllowed(get(/databases/$(database)/documents/shipments/$(shipmentId)).data.destinationBranchId)
          )) ||
          (isDriver() && ('assignedVehicle' in get(/databases/$(database)/documents/shipments/$(shipmentId)).data) &&
           get(/databases/$(database)/documents/shipments/$(shipmentId)).data.assignedVehicle.driverUid == request.auth.uid)
        );
        allow create, update, delete: if false; // Solo backend append-only
      }

      // Subcolección: storage_moves (Historial de traslados físicos entre módulos)
      match /storage_moves/{moveId} {
        allow read: if isActive() && (
          isAdmin() ||
          isTreasury() ||
          ((isCashier() || isAgencyManager()) && (
            isBranchAllowed(get(/databases/$(database)/documents/shipments/$(shipmentId)).data.originBranchId) ||
            isBranchAllowed(get(/databases/$(database)/documents/shipments/$(shipmentId)).data.destinationBranchId)
          ))
        );
        allow create: if isActive() && isCashier() && (
          isBranchAllowed(get(/databases/$(database)/documents/shipments/$(shipmentId)).data.originBranchId) ||
          isBranchAllowed(get(/databases/$(database)/documents/shipments/$(shipmentId)).data.destinationBranchId)
        );
        allow update, delete: if false; // Inmutable append-only
      }
    }

    // =========================================================================
    // COLECCIÓN: manifests (Despachos y Manifiestos de Carga)
    // =========================================================================
    match /manifests/{manifestId} {
      allow read: if isActive() && (
        isAdmin() ||
        isTreasury() ||
        ((isCashier() || isAgencyManager()) && (
          isBranchAllowed(resource.data.originBranchId) ||
          isBranchAllowed(resource.data.destinationBranchId)
        )) ||
        (isDriver() && resource.data.driverUid == request.auth.uid)
      );
      allow create: if isActive() && isCashier() && isBranchAllowed(request.resource.data.originBranchId);
      allow update: if isActive() && (
        (isCashier() && isBranchAllowed(resource.data.originBranchId)) ||
        (isDriver() && resource.data.driverUid == request.auth.uid)
      );
      allow delete: if false;
    }

    // =========================================================================
    // COLECCIÓN: cash_shifts (Turnos de Caja por Secretaria)
    // =========================================================================
    match /cash_shifts/{shiftId} {
      // Secretaria lee su propio turno; encargados y tesorería ven los de su sucursal o global
      allow read: if isActive() && (
        resource.data.operatorUid == request.auth.uid ||
        (isAgencyManager() && isBranchAllowed(resource.data.branchId)) ||
        isTreasury() ||
        isAdmin()
      );

      // Apertura de turno
      allow create: if isActive() && isCashier() &&
        request.resource.data.operatorUid == request.auth.uid &&
        isBranchAllowed(request.resource.data.branchId) &&
        request.resource.data.status == 'open' &&
        request.resource.data.initialCash >= 0;

      // Cierre de turno: solo el mismo operador mientras está abierto, o administrador
      allow update: if isActive() && (
        (resource.data.operatorUid == request.auth.uid && resource.data.status == 'open') ||
        isAdmin()
      );

      allow delete: if false; // Inmutable

      // Subcolección: movements (Movimientos de caja del turno)
      match /movements/{movementId} {
        allow read: if isActive() && (
          get(/databases/$(database)/documents/cash_shifts/$(shiftId)).data.operatorUid == request.auth.uid ||
          (isAgencyManager() && isBranchAllowed(get(/databases/$(database)/documents/cash_shifts/$(shiftId)).data.branchId)) ||
          isTreasury() ||
          isAdmin()
        );
        allow create: if isActive() && isCashier() &&
          get(/databases/$(database)/documents/cash_shifts/$(shiftId)).data.status == 'open' &&
          get(/databases/$(database)/documents/cash_shifts/$(shiftId)).data.operatorUid == request.auth.uid &&
          isBranchAllowed(get(/databases/$(database)/documents/cash_shifts/$(shiftId)).data.branchId);
        allow update, delete: if false; // Movimientos financieros inmutables append-only
      }
    }

    // =========================================================================
    // COLECCIÓN: fixed_assets (Inventario / Bienes Fijos de Expreso Punata)
    // =========================================================================
    match /fixed_assets/{assetId} {
      allow read: if isActive() && (isAdmin() || isAgencyManager() || isTreasury() || isCashier());
      allow create: if isActive() && (isAgencyManager() || isTreasury() || isAdmin());
      allow update: if isActive() && (isAgencyManager() || isTreasury() || isAdmin());
      allow delete: if false;

      match /audit_logs/{auditId} {
        allow read: if isActive() && (isAdmin() || isAgencyManager() || isTreasury());
        allow create: if isActive() && (isAgencyManager() || isTreasury() || isAdmin());
        allow update, delete: if false;
      }
    }

    // =========================================================================
    // COLECCIONES SINDICALES: members, dues, workers, worker_payments, expenses
    // =========================================================================
    match /union_members/{memberId} {
      allow read: if isActive() && (isTreasury() || isAdmin() || isAgencyManager());
      allow write: if isActive() && (isTreasury() || isAdmin());
    }

    match /union_dues/{dueId} {
      allow read: if isActive() && (isTreasury() || isAdmin() || isAgencyManager());
      allow write: if isActive() && (isTreasury() || isAdmin());

      match /payments/{paymentId} {
        allow read: if isActive() && (isTreasury() || isAdmin() || isAgencyManager());
        allow create: if isActive() && (isTreasury() || isAdmin());
        allow update, delete: if false;
      }
    }

    match /union_workers/{workerId} {
      allow read: if isActive() && (isTreasury() || isAdmin());
      allow write: if isActive() && (isTreasury() || isAdmin());
    }

    match /union_worker_payments/{paymentId} {
      allow read: if isActive() && (isTreasury() || isAdmin());
      allow create: if isActive() && (isTreasury() || isAdmin());
      allow update, delete: if false;
    }

    match /union_expenses/{expenseId} {
      allow read: if isActive() && (isTreasury() || isAdmin());
      allow create: if isActive() && (isTreasury() || isAdmin());
      allow update, delete: if false;
    }

    // =========================================================================
    // COLECCIÓN: audit_logs (Logs de auditoría inmutables)
    // =========================================================================
    match /audit_logs/{auditId} {
      allow read: if isActive() && isAdmin();
      allow write: if false; // Exclusivo de Cloud Functions con Admin SDK
    }

    // =========================================================================
    // REGLA POR DEFECTO: DENEGAR TODO ACCESO NO ESPECIFICADO
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
