# =============================================================================
# EXPRESO PUNATA 1.0 — PLANTILLA DE VARIABLES DE ENTORNO (.env.local)
# =============================================================================
# Copie este archivo como .env.local para su entorno de desarrollo individual.
# NUNCA suba .env.local a Git ni coloque contraseñas o claves maestras aquí.
# =============================================================================

# -----------------------------------------------------------------------------
# MODO 1: DESARROLLO LOCAL AISLADO CON EMULADORES (RECOMENDADO POR DEFECTO)
# -----------------------------------------------------------------------------
# En este modo, no se consume ningún recurso en la nube ni se tocan datos reales.
# Todos los servicios de Firebase se ejecutan localmente en 127.0.0.1:
#   - Firebase Auth:       http://127.0.0.1:9099
#   - Cloud Firestore:     127.0.0.1:8080
#   - Cloud Storage:       http://127.0.0.1:9199
#   - Cloud Functions:     http://127.0.0.1:5001
VITE_USE_FIREBASE_EMULATORS=true

# Las siguientes variables son sintéticas / demo para desarrollo local con emulador:
VITE_FIREBASE_API_KEY=demo-api-key-expreso-punata
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-expreso-punata
VITE_FIREBASE_STORAGE_BUCKET=demo-expreso-punata.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:demo-local

# -----------------------------------------------------------------------------
# MODO 2: CONEXIÓN A FIREBASE CLOUD DEVELOPMENT (ÚNICAMENTE SI ESTÁ AUTORIZADO)
# -----------------------------------------------------------------------------
# Para conectar el frontend a la nube de desarrollo 'expreso-punata-dev':
# 1. Cambie VITE_USE_FIREBASE_EMULATORS a false.
# 2. Descomente y complete las credenciales del proyecto expreso-punata-dev.
# ¡ADVERTENCIA! No apunte nunca a un proyecto de Producción sin autorización expresa.
#
# VITE_USE_FIREBASE_EMULATORS=false
# VITE_FIREBASE_API_KEY=AIzaSy...
# VITE_FIREBASE_AUTH_DOMAIN=expreso-punata-dev.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=expreso-punata-dev
# VITE_FIREBASE_STORAGE_BUCKET=expreso-punata-dev.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=405140168085
# VITE_FIREBASE_APP_ID=1:405140168085:web:a94720c5be75f910996a9c
