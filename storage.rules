rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    // Seguridad autoritativa: el documento en Firestore manda sobre claims antiguos del token
    function isAuthoritativeActiveUser() {
      return isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        getUserDoc().isActive == true &&
        ('isActive' in request.auth.token ? request.auth.token.isActive == true : true);
    }
    
    function getUserRole() {
      return isAuthoritativeActiveUser() ? getUserDoc().role : null;
    }

    function getUserBranch() {
      return isAuthoritativeActiveUser() ? getUserDoc().primaryBranchId : null;
    }
    
    function isAdmin() {
      return isAuthoritativeActiveUser() && getUserRole() == 'directiva_admin';
    }

    function isTreasury() {
      return isAuthoritativeActiveUser() && (getUserRole() == 'tesoreria' || isAdmin());
    }

    function getShipment(shipmentId) {
      return firestore.get(/databases/(default)/documents/shipments/$(shipmentId)).data;
    }

    function canAccessShipment(shipmentId) {
      return isAuthoritativeActiveUser() && firestore.exists(/databases/(default)/documents/shipments/$(shipmentId)) && (
        isAdmin() ||
        isTreasury() ||
        (getUserBranch() != null && (
          getShipment(shipmentId).originBranchId == getUserBranch() ||
          getShipment(shipmentId).destinationBranchId == getUserBranch()
        )) ||
        (getUserRole() == 'conductor' && (
          (('assignedVehicle' in getShipment(shipmentId)) &&
           getShipment(shipmentId).assignedVehicle.driverUid == request.auth.uid) ||
          (('collectedByDriverUid' in getShipment(shipmentId)) &&
           getShipment(shipmentId).collectedByDriverUid == request.auth.uid)
        ))
      );
    }

    // Comprobantes de encomiendas y firmas de entrega (restringidos a imágenes < 2MB)
    match /shipments/{shipmentId}/{allPaths=**} {
      allow read: if canAccessShipment(shipmentId);
      allow write: if canAccessShipment(shipmentId) && (
        getUserRole() in ['secretaria', 'encargado_agencia', 'directiva_admin', 'tesoreria'] ||
        (getUserRole() == 'conductor')
      ) && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Fotos de inventario de bienes fijos
    match /assets/{assetId}/{fileName} {
      allow read: if isAuthoritativeActiveUser() && (getUserRole() in ['encargado_agencia', 'directiva_admin', 'tesoreria', 'secretaria']);
      allow write: if isAuthoritativeActiveUser() && (getUserRole() in ['encargado_agencia', 'directiva_admin', 'tesoreria']);
    }

    // Por defecto: denegar todo
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
