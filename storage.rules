rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    // Seguridad autoritativa: el documento en Firestore manda sobre claims antiguos del token
    function isAuthoritativeActiveUser() {
      return isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        getUserDoc().role != 'soporte_pachax' &&
        getUserDoc().role != 'afiliado' &&
        getUserDoc().isActive == true &&
        ('isActive' in request.auth.token ? request.auth.token.isActive == true : true);
    }
    
    function getUserRole() {
      return isAuthoritativeActiveUser() ? getUserDoc().role : null;
    }

    function getUserBranch() {
      return isAuthoritativeActiveUser() ? getUserDoc().primaryBranchId : null;
    }
    
    function isAdmin() {
      return isAuthoritativeActiveUser() && (
        getUserRole() == 'directiva_admin' ||
        (getUserRole() == 'afiliado_admin' &&
          getUserDoc().get('primaryBranchId', '') in ['punata', 'cochabamba'] &&
          getUserDoc().get('allowedBranchIds', []) is list &&
          getUserDoc().get('allowedBranchIds', []).hasAll(['punata', 'cochabamba']))
      );
    }

    function isTreasury() {
      return isAuthoritativeActiveUser() && (getUserRole() == 'tesoreria' || isAdmin());
    }

    function shipmentPhotosEnabled() {
      let configPath = /databases/(default)/documents/system_config/expreso_punata;
      return firestore.exists(configPath) &&
        firestore.get(configPath).data.get('storagePhotosEnabled', false) == true;
    }

    function getShipment(shipmentId) {
      return firestore.get(/databases/(default)/documents/shipments/$(shipmentId)).data;
    }

    function canAccessShipment(shipmentId) {
      let userExists = isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
      let user = userExists ? getUserDoc() : {};
      let role = user.get('role', '');
      let profileActive = userExists &&
        role != 'soporte_pachax' &&
        role != 'afiliado' &&
        user.get('isActive', false) == true &&
        (!('isActive' in request.auth.token) || request.auth.token.isActive == true);
      let admin = role == 'directiva_admin' ||
        (role == 'afiliado_admin' &&
          user.get('primaryBranchId', '') in ['punata', 'cochabamba'] &&
          user.get('allowedBranchIds', []) is list &&
          user.get('allowedBranchIds', []).hasAll(['punata', 'cochabamba']));
      let branch = user.get('primaryBranchId', null);
      let shipmentExists = profileActive &&
        firestore.exists(/databases/(default)/documents/shipments/$(shipmentId));
      let shipment = shipmentExists ? getShipment(shipmentId) : {};
      let branchMatch = branch != null &&
        (shipment.get('originBranchId', '') == branch ||
         shipment.get('destinationBranchId', '') == branch);
      let assignedToConductor = role == 'conductor' && (
        (('assignedVehicle' in shipment) &&
          shipment.assignedVehicle.driverUid == request.auth.uid) ||
        (('collectedByDriverUid' in shipment) &&
          shipment.collectedByDriverUid == request.auth.uid));
      return profileActive &&
        (admin || role in ['secretaria', 'encargado_agencia', 'tesoreria', 'conductor']) &&
        shipmentExists &&
        (admin || role == 'tesoreria' || branchMatch || assignedToConductor);
    }

    // Comprobantes de encomiendas y firmas de entrega (restringidos a imágenes < 2MB)
    match /shipments/{shipmentId}/{allPaths=**} {
      allow read: if canAccessShipment(shipmentId);
      allow create: if canAccessShipment(shipmentId) && (
        (isAdmin() || getUserRole() in ['secretaria', 'encargado_agencia', 'tesoreria']) ||
        (getUserRole() == 'conductor')
      ) && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && shipmentPhotosEnabled();
      allow update, delete: if false;
    }

    // Fotos de inventario de bienes fijos
    match /assets/{assetId}/{fileName} {
      allow read: if isAuthoritativeActiveUser() && (isAdmin() || getUserRole() in ['encargado_agencia', 'tesoreria']);
      allow write: if isAuthoritativeActiveUser() && (isAdmin() || getUserRole() in ['encargado_agencia', 'tesoreria']);
    }

    // Por defecto: denegar todo
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
