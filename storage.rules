rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isActiveUser() {
      return isAuthenticated() && ('isActive' in request.auth.token && request.auth.token.isActive == true);
    }
    
    function getUserRole() {
      return 'role' in request.auth.token ? request.auth.token.role : null;
    }
    
    function isStaff() {
      return isActiveUser() && (
        getUserRole() in ['secretaria', 'encargado_agencia', 'tesoreria', 'directiva_admin']
      );
    }
    
    function isDriver() {
      return isActiveUser() && getUserRole() == 'conductor';
    }

    // Comprobantes de encomiendas y firmas de entrega
    match /shipments/{shipmentId}/{fileName} {
      allow read: if isStaff() || isDriver();
      allow write: if isStaff() || (isDriver() && fileName.matches('delivery_.*'));
    }

    // Fotos de inventario de bienes fijos
    match /assets/{assetId}/{fileName} {
      allow read: if isStaff();
      allow write: if isActiveUser() && (getUserRole() in ['encargado_agencia', 'directiva_admin', 'tesoreria']);
    }

    // Por defecto: denegar todo
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
