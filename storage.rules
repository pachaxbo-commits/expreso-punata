rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isActiveUser() {
      return isAuthenticated() &&
        ('isActive' in request.auth.token && request.auth.token.isActive == true);
    }
    
    function getUserRole() {
      return 'role' in request.auth.token ? request.auth.token.role : null;
    }

    function getUserBranch() {
      return 'branchId' in request.auth.token ? request.auth.token.branchId : null;
    }
    
    function isAdmin() {
      return isActiveUser() && getUserRole() == 'directiva_admin';
    }

    function isTreasury() {
      return isActiveUser() && (getUserRole() == 'tesoreria' || isAdmin());
    }

    function getShipment(shipmentId) {
      return firestore.get(/databases/(default)/documents/shipments/$(shipmentId)).data;
    }

    function canAccessShipment(shipmentId) {
      return isActiveUser() && firestore.exists(/databases/(default)/documents/shipments/$(shipmentId)) && (
        isAdmin() ||
        isTreasury() ||
        (getUserBranch() != null && (
          getShipment(shipmentId).originBranchId == getUserBranch() ||
          getShipment(shipmentId).destinationBranchId == getUserBranch()
        )) ||
        (getUserRole() == 'conductor' &&
         ('assignedVehicle' in getShipment(shipmentId)) &&
         getShipment(shipmentId).assignedVehicle.driverUid == request.auth.uid)
      );
    }

    // Comprobantes de encomiendas y firmas de entrega restringidos por sucursal y asignación
    match /shipments/{shipmentId}/{fileName} {
      allow read: if canAccessShipment(shipmentId);
      allow write: if canAccessShipment(shipmentId) && (
        getUserRole() in ['secretaria', 'encargado_agencia', 'directiva_admin', 'tesoreria'] ||
        (getUserRole() == 'conductor' && fileName.matches('delivery_.*'))
      );
    }

    // Fotos de inventario de bienes fijos
    match /assets/{assetId}/{fileName} {
      allow read: if isActiveUser() && (getUserRole() in ['encargado_agencia', 'directiva_admin', 'tesoreria', 'secretaria']);
      allow write: if isActiveUser() && (getUserRole() in ['encargado_agencia', 'directiva_admin', 'tesoreria']);
    }

    // Por defecto: denegar todo
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
